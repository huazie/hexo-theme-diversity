// 开源页全屏展示：突破 .wrapper 的 80% 宽度限制
.open-page
    #content
        max-width 100%
        margin 0
    #content-inner
        margin-left 0
    .article-container
        float none
    .article-inner
        border-radius 0
        box-shadow none
        margin 0
        background-color transparent
    .inner
        padding 0 40px
    .article-title
        float none
        display flex
        align-items center
        gap 10px
        .open-title-ico
            width 0.95em
            height 0.95em
            fill currentColor
            flex-shrink 0

// 标题行：标题居左，切换按钮靠右下侧（同行展示）
.open-title-row
    display flex
    align-items center
    flex-wrap wrap
    gap 8px 12px
    margin-bottom 8px

#open-list
    max-width 1600px
    margin 0 auto

// 开源项目展示（统一使用 CSS 变量适配 light/dark）
.open-toolbar
    display flex
    align-items center
    gap 8px
    margin-left auto

.open-switch
    font-family font-page
    font-size 0.9em
    width 36px
    height 36px
    padding 0
    display inline-flex
    align-items center
    justify-content center
    border 1px solid var(--header-divider-color)
    border-radius 8px
    background-color var(--content-bg-color)
    color var(--text-color)
    cursor pointer
    transition all 0.2s
    &:hover
        border-color color-link
        color color-link
    &.active
        border-color color-link
        background-color color-link
        color #fff
        .open-ico
            fill #fff

.open-ico
    width 18px
    height 18px
    fill currentColor

#open-list
    transition all 0.3s ease

.open-card
    background-color var(--content-bg-color)
    border 1px solid var(--header-divider-color)
    border-radius 8px
    padding 20px
    box-shadow 0 3px 8px 6px rgba(7, 17, 27, 0.09)
    transition transform 0.2s, box-shadow 0.2s
    &:hover
        transform translateY(-4px)
        box-shadow 0 6px 16px 8px rgba(7, 17, 27, 0.15)

.open-card-head
    display flex
    align-items center
    gap 12px
    margin-bottom 12px

.open-logo
    width 72px
    height 72px
    border-radius 12px
    object-fit contain
    flex-shrink 0
    background-color var(--content-bg-color)

.open-logo-default
    display block

.open-name
    font-family font-page
    font-size 1.3em
    font-weight bold
    color var(--text-color)
    margin 0
    min-width 0
    overflow-wrap break-word

.open-desc
    font-family font-page
    font-size 0.95em
    line-height 1.6
    color var(--text-color)
    opacity 0.85
    margin 0 0 8px 0
    overflow-wrap break-word
    word-break break-word
    &.clamp
        display -webkit-box
        -webkit-box-orient vertical
        -webkit-line-clamp 2
        overflow hidden

.open-more
    display inline-block
    margin-top 0
    margin-bottom 8px
    padding 2px 0
    font-size 0.78em
    color color-link
    cursor pointer
    user-select none

.open-meta
    display flex
    flex-wrap wrap
    gap 6px
    margin-bottom 10px

// shields.io 风格徽章：深灰标签 + 彩色值
.open-badge
    display inline-flex
    align-items center
    font-size 0.72em
    line-height 1
    border-radius 4px
    overflow hidden
    .open-badge-label
        padding 4px 6px
        background-color #586069
        color #fff
    .open-badge-value
        padding 4px 6px
        color #fff

.open-badge-author .open-badge-value
    background-color #a371f7
.open-badge-lang .open-badge-value
    background-color #007ec6
// 竖线只加在语言值之间（Language 标签与首个语言之间不加）
// 用 border-left 实现：不撑高行高，左右间隔由相邻 value 的 padding 对称
.open-badge-lang .open-badge-value + .open-badge-value
    border-left 1px solid rgba(255, 255, 255, 0.55)
.open-badge-license .open-badge-value
    background-color #fe7d37

.open-badge-link
    text-decoration none
    &:hover
        opacity 0.85

.open-tags
    margin-bottom 12px

.open-tag
    display inline-block
    font-size 0.75em
    padding 2px 8px
    margin 0 6px 6px 0
    border-radius 10px
    background-color color-pale-gray
    color color-dark-gray

.open-links
    display flex
    gap 12px

.open-link
    font-size 0.85em
    color color-link
    text-decoration none
    &:hover
        color color-link-hover
        text-decoration underline

.open-empty
    text-align center
    color color-gray
    padding 40px 0

// 方格布局（grid）：磁贴式，内容左对齐（logo 在顶部，文字靠左），同行卡片等高、链接贴底
.open-grid
    display grid
    grid-template-columns repeat(auto-fill, minmax(320px, 1fr))
    gap 24px
    align-items stretch
    .open-card
        display flex
        flex-direction column
    .open-card-head
        justify-content flex-start
        margin-bottom 12px
    .open-card-body
        display flex
        flex-direction column
        flex 1
        min-width 0
        align-items flex-start
        text-align left
        // 方格模式：名称在 head（logo 旁）展示，body 里的名称隐藏
        .open-name
            display none
    .open-links
        margin-top auto
        justify-content flex-start

// 列表布局（list）：左侧图标 + 右侧内容（真正的行式列表，名称在内容区顶部）
.open-list
    display flex
    flex-direction column
    gap 16px
    .open-card
        display flex
        flex-direction row
        align-items flex-start
        gap 20px
    .open-card-head
        flex 0 0 auto
        margin-bottom 0
        // 列表模式：名称在 body 顶部，head 里的名称隐藏
        .open-name
            display none
    .open-card-body
        flex 1
        min-width 0
        display flex
        flex-direction column
        .open-name
            margin 0 0 8px 0
    .open-links
        margin-top 0

@media mq-mobile
    // 方格：手机端保持两列磁贴；内容自适应，避免右侧溢出
    .open-page
        .inner
            // 手机端方格到屏幕左右边缘的间隔缩小（原 15px，现 8px；桌面 40px）
            padding 0 8px
    .open-grid
        grid-template-columns repeat(2, 1fr)
        // 手机端两列之间的间隔缩小（原为 12px）
        gap 8px
        .open-card
            padding 12px
            // grid item 默认 min-width:auto 会被内部内容撑开列宽，造成整体溢出右侧；归零后由内部断行控制
            min-width 0
            overflow-wrap anywhere
            word-break break-word
        .open-card-head
            justify-content flex-start
            margin-bottom 8px
        .open-logo
            width 36px
            height 36px
            margin 0
        .open-name
            font-size 0.9em
        .open-card-body
            align-items flex-start
            text-align left
        .open-desc
            font-size 0.78em
            margin 4px 0 8px
        // 徽章容器换行，避免单行过宽撑破列
        .open-meta
            display flex
            flex-wrap wrap
            gap 4px
            margin-bottom 8px
        .open-badge
            // 手机端在 0.68em 基础上约减 2px：按 16px 基准 0.12em≈1.92px；
            // 注：hexo 链路会丢弃 em-px 混合的 calc()，故用纯 em 实现，自适应父级字号
            font-size 0.56em
        .open-tags
            margin-bottom 8px
            line-height 1.7
        .open-link
            font-size 0.78em
        .open-links
            gap 8px
            flex-wrap wrap
    // 列表：单列横向行（图标+名称在左，描述/元信息/标签/链接在右）
    .open-list
        .open-card
            flex-direction row
            align-items flex-start
            padding 12px
            gap 12px
        .open-card-head
            flex 0 0 auto
            margin-bottom 0
        .open-logo
            width 48px
            height 48px
            margin 0
        .open-name
            font-size 1.05em
