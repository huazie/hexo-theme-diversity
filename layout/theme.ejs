<% /* jQuery 仅本页（主题展示页）需要：theme-rotate.js / gritter / theme.js 均依赖 $；
      置于所有 defer 脚本之前，保证按文档序最先执行；其他页面不再加载 */ %>
<script src="<%- url_for('js/jquery-3.6.0.min.js') %>" defer></script>
<div class="theme-wrap">
    <div class="theme-inner">
        <%
            // 主题图片路径配置
            let themeImagePath = {};
            for (let i = 0; i < theme.themes.length; i++) {
                themeImagePath[theme.themes[i]] = theme.path[theme.themes[i]];
            }
            // 配置的主题个数
            const themeNum = theme.themes.length;
            const ROTATE_NUM = 10;
        %>
        <% // 配置的主题个数小于等于10，采用10个图片的曲屏环形旋转样式布局 %>
        <% if (themeNum <= ROTATE_NUM) { %>
        <%- partial('_partial/rotate_theme', {themeImagePath: themeImagePath, themeNum: themeNum, rotateNum: ROTATE_NUM}) %>
        <% } %>
    </div>
    <% // 配置的主题个数小于等于10，添加mobile端主题页左右切换箭头 %>
    <% if (themeNum <= ROTATE_NUM) { %>
    <div class="arrow-wrap">
        <div class="left-arrow"></div>
        <div class="right-arrow"></div>
    </div>
    <script src="<%- url_for('js/gsap-3.6.1.min.js') %>" defer></script>
    <script src="<%- url_for('js/theme-rotate.js') %>" defer></script>
    <% } %>
</div>

<%- partial('_partial/footer', {footerId: "theme-footer"}) %>

<script src="<%- url_for('js/jquery.gritter-1.7.4.min.js') %>" defer></script>
<% /* theme.js 依赖 jQuery（IIFE 传参 + 立即选择器绑定），与 jQuery 同批 defer 按文档序执行 */ %>
<%- js({src: 'js/theme', defer: true}) %>